# Copie este arquivo para ".env" (sem o .example) e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado no git.

# Chave da API da Groq — pegue em https://console.groq.com/keys
GROQ_API_KEY=gsk_coloque_sua_chave_real_aqui

# Modo desenvolvimento — ativa bypass de auth em localhost (NÃO usar em produção)
DEV_MODE=false

# Se tiver outras chaves no futuro, siga o mesmo padrão:
# ASAAS_API_KEY=
# STRIPE_SECRET_KEY=
