# Firebase
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_DATABASE_URL=https://playearn-b001b-default-rtdb.firebaseio.com

# Asaas (pagamentos)
ASAAS_API_KEY=sua_chave_asaas

# Admin
ADMIN_EMAIL=alegomes488@gmail.com

# Segurança
WEBHOOK_SECRET=seu_token_webhook_seguro
N8N_SHARED_SECRET=seu_token_n8n

# CORS (produção)
# TAREFA 4.4: liste APENAS as origens do frontend. NUNCA use * em produção.
# Origem NÃO listada -> browser bloqueia a chamada (erro de CORS).
ALLOWED_ORIGINS=https://admin.seudominio.com,https://app.seudominio.com

# Desenvolvimento
ADMIN_PORT=8080
BACKEND_PORT=7861

# App Check Enforcement (BACKEND ONLY)
# TAREFA 4.1: OBRIGATÓRIO por padrão em produção. Em dev/testes desative
# explicitamente. Quando ativo, requisições a /api/* e /payments/* sem header
# X-Firebase-AppCheck válido são rejeitadas (401).
APP_CHECK_REQUIRED=false
FIREBASE_PROJECT_ID=seu-project-id-aqui
FIREBASE_APP_ID=seu-app-id-aqui

# Asaas pagamentos
# SIMULATION_MODE=true (padrão): NENHUM PIX real é enviado (IDs prefixados SIM_).
# Em produção: SIMULATION_MODE=false + ASAAS_API_KEY real.
SIMULATION_MODE=true
